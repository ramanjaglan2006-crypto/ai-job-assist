# ─── LLM Provider ────────────────────────────────────────────────────────────
# Google Gemini API key (get free at https://aistudio.google.com)
# Used for: resume extraction, conversational AI, job matching explanations
# Without this, the app falls back to rule-based matching (fully functional but less conversational)
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Optional: OpenAI fallback ───────────────────────────────────────────────
# If set, used as secondary fallback when Gemini is unavailable
# OPENAI_API_KEY=sk-...

# ─── App Config ──────────────────────────────────────────────────────────────
# Node environment
NODE_ENV=development

# ─── Session Storage ─────────────────────────────────────────────────────────
# Sessions are stored as JSON files in data/sessions/<session-id>.json
# No database required. To reset: delete files in data/sessions/
# SESSION_TTL_HOURS=24  # future: auto-cleanup sessions older than N hours

# ─── Deployment ──────────────────────────────────────────────────────────────
# Set for production deployments
# NEXT_PUBLIC_APP_URL=https://your-deployment-url.vercel.app
