# ─── LLM Provider ────────────────────────────────────────────────────────────
# Google Gemini API key — get one free at https://aistudio.google.com/apikey
# Supported formats: new AQ. keys (default from AI Studio) and legacy AIza... keys
# SDK: @google/genai v2+ — supports both key formats via standard GEMINI_API_KEY env var
# Used for: resume extraction, conversational AI, job matching explanations
# Without this, the app falls back to rule-based matching (fully functional but less conversational)
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Live Job Sources (all optional — app works without them) ─────────────────

# Adzuna: 10M+ jobs across India, US, UK, Australia
# Free signup at https://developer.adzuna.com → get app_id + app_key
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# JSearch via RapidAPI: aggregates LinkedIn, Indeed, Glassdoor
# Free tier: 500 req/month. Sign up at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=your_rapidapi_key

# ─── App Config ──────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Optional: OpenAI fallback ───────────────────────────────────────────────
# If set, used as secondary fallback when Gemini is unavailable
# OPENAI_API_KEY=sk-...

# ─── App Config ──────────────────────────────────────────────────────────────
# Node environment
NODE_ENV=development

# ─── Session Storage ─────────────────────────────────────────────────────────
# Sessions are stored as JSON files in data/sessions/<session-id>.json
# No database required. To reset: delete files in data/sessions/
# SESSION_TTL_HOURS=24  # future: auto-cleanup sessions older than N hours

# ─── Deployment ──────────────────────────────────────────────────────────────
# Set for production deployments
# NEXT_PUBLIC_APP_URL=https://your-deployment-url.vercel.app
